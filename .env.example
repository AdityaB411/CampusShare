# CampusShare Environment Variables Template
# Copy this file to .env or frontend/.env for local development

# Supabase Public API Configuration
# Use only your project URL and public anon key.
# NEVER expose the service-role or secret key in the frontend client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Default Campus / Institution Identifier
VITE_CAMPUS_ID=main-campus
